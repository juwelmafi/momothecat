# ========================================================
# MOMO - THE CAT (momothecat.shop) ENVIRONMENT CONFIG
# ========================================================

# MongoDB Connection String (Atlas or Local)
# If left empty, the application runs seamlessly using built-in high-performance in-memory persistence with full initial seed data.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/momothecat?retryWrites=true&w=majority

# NextAuth / Admin Secret (Optional)
NEXTAUTH_SECRET=momo_the_cat_super_secret_key_2026
NEXTAUTH_URL=http://localhost:3000

# Stripe (Dormant in Phase 1 / Active in Phase 2)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample

# Amazon Affiliate Associate Tag
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=momothecat-20
